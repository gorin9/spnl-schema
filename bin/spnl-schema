#!/usr/bin/env ruby
require "optparse"
require "fileutils"
require_relative "../lib/spnl_schema"
opts = {}
parser = OptionParser.new do |o|
  o.banner = 'Usage: spnl-schema SCHEMA.sql [--check] [--table NAME] [--out-dir DIR] [--rbs-dir DIR]'
  o.on('--check') { opts[:check] = true }
  o.on('--table NAME') { |x| opts[:table] = x }
  o.on('--out-dir DIR') { |x| opts[:out] = x }
  o.on('--rbs-dir DIR') { |x| opts[:rbs] = x }
  o.on('-h', '--help') { puts o; exit }
end
begin
  parser.parse!
  raise ArgumentError, 'expected one schema file' unless ARGV.length == 1
  tables = SpnlSchema.parse(File.read(ARGV.first))
  tables = tables.select { |t| t[:name] == opts[:table] } if opts[:table]
  raise ArgumentError, 'no matching table' if tables.empty?
  unless opts[:check]
    [opts[:out], opts[:rbs]].compact.each { |p| FileUtils.mkdir_p(p) }
    tables.each do |t|
      stem = t[:class_name].gsub(/([a-z0-9])([A-Z])/, '\1_\2').downcase
      code = SpnlSchema.emit_class(t)
      opts[:out] ? File.write(File.join(opts[:out], stem+'.generated.rb'), code) : puts(code)
      File.write(File.join(opts[:rbs], stem+'.rbs'), SpnlSchema.emit_rbs(t)) if opts[:rbs]
    end
  end
rescue ArgumentError, OptionParser::ParseError, Errno::ENOENT => e
  warn "spnl-schema: #{e.message}"
  exit 1
end
